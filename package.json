{
  "name": "airtouch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "firmware:compile": "arduino-cli compile --fqbn arduino:avr:nano:cpu=atmega328old firmware/airtouch_firmware",
    "firmware:compile:new": "arduino-cli compile --fqbn arduino:avr:nano:cpu=atmega328 firmware/airtouch_firmware",
    "firmware:upload": "arduino-cli upload --fqbn arduino:avr:nano:cpu=atmega328old firmware/airtouch_firmware",
    "firmware:upload:new": "arduino-cli upload --fqbn arduino:avr:nano:cpu=atmega328 firmware/airtouch_firmware",
    "firmware:flash": "arduino-cli compile --upload --fqbn arduino:avr:nano:cpu=atmega328old firmware/airtouch_firmware",
    "firmware:flash:new": "arduino-cli compile --upload --fqbn arduino:avr:nano:cpu=atmega328 firmware/airtouch_firmware",
    "firmware:boards": "arduino-cli board list"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/rapier": "^1.5.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^5.3.1"
  }
}
